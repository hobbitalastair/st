pkgname=st
pkgver=0.9.3.r4.g3bd2b1c
pkgrel=1
pkgdesc='A simple virtual terminal emulator for X.'
arch=('i686' 'x86_64')
license=('MIT')
depends=('wayland' 'libxkbcommon' 'fcft' 'terminus-font')
makedepends=('ncurses' 'git' 'pkg-config' 'wayland-protocols' 'tllist')
url="http://st.suckless.org"
source=("${pkgname}::git+file://$(realpath "${PWD}/../..")#branch=patched"
        config.h)
sha256sums=('SKIP'
            '98a493e11d72436bf947bf81e42b56de67fa1db716e3813b37bed51d17a18cd3')

pkgver() {
    cd "$pkgname"
    git describe --tags --long --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$srcdir/$pkgname"
    sed -i '/tic /d' Makefile
    cp "$srcdir"/config.h config.h
}

build() {
    cd "$srcdir/$pkgname"
    make X11INC=/usr/include/X11 X11LIB=/usr/lib/X11
}

package() {
    cd "$srcdir/$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" TERMINFO="$pkgdir/usr/share/terminfo" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README "$pkgdir/usr/share/doc/$pkgname/README"

    rm -rf "${pkgdir}/usr/share/terminfo/"
}
